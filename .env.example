# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/koapos
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Destructive-script guard (transfer-merchant) ─────────────────────────────
# Required by the transfer-merchant CLI to confirm which database it may modify.
# EXPECTED_DB must be set on the command line for any destructive run.
#   EXPECTED_DB=development | production
# Optional but recommended: lock each environment to a specific database by its
# fingerprint (a short sha256 of the connection host + db name), so a destructive
# run aborts if DATABASE_URL ever points somewhere else. Print the fingerprint of
# the database you are currently pointed at with:
#   pnpm --filter @workspace/api-server run db-fingerprint
# It reads only DATABASE_URL, opens no connection, and prints no secret.
DB_FINGERPRINT_DEVELOPMENT=
DB_FINGERPRINT_PRODUCTION=

# ─── Token Vault ──────────────────────────────────────────────────────────────
# Optional: dedicated 32+ char string for AES-256-CBC token encryption.
# Falls back to SESSION_SECRET if not set.
VAULT_ENCRYPTION_KEY=change-me-to-a-32char-random-string

# ─── Cloud Storage ────────────────────────────────────────────────────────────
# Google (shared client for Drive, Business Profile, Contacts/Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (shared client for OneDrive, Contacts/Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ─── Business & Finance ───────────────────────────────────────────────────────
# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Address autocomplete (Addressr / G-NAF) — cheaper alternative to Google Places.
# Point at a self-hosted Addressr instance. Feature is disabled if ADDRESSR_BASE_URL is unset.
ADDRESSR_BASE_URL=
ADDRESSR_API_KEY=

# QuickBooks Online (Intuit)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Stripe is a per-merchant credentials integration: each merchant enters their
# own Secret Key + Publishable Key (+ webhook signing secret) in the app, stored
# encrypted in the vault. No platform-level Stripe env vars are required.

# Zip Pay (buy-now-pay-later) — AU In-store QR code API. Each merchant connects
# their OWN independent Zip account: the apiKey, locationId, deviceRefCode AND
# webhook signing secret are entered per merchant in the app and encrypted in the
# token vault. The only platform-level setting is the API host, shared by all
# merchants.
#   ZIP_API_BASE — API host. Production: https://api.zip.co
#                  Sandbox:    https://api.sandbox.zip.co (use while testing).
ZIP_API_BASE=https://api.zip.co

# Afterpay (buy-now-pay-later). Same per-merchant model as Zip: each merchant
# enters their own merchantId, apiKey and webhook signing secret in the app
# (encrypted in the vault). Only the API host is platform-level.
#   AFTERPAY_API_BASE — API host; use the Afterpay sandbox host while testing.
AFTERPAY_API_BASE=https://global-api.afterpay.com

# Klarna (buy-now-pay-later). Same per-merchant model: each merchant enters their
# own merchantId, apiKey and webhook signing secret in the app (encrypted in the
# vault). Only the API host is platform-level (region-specific: EU api.klarna.com,
# US api-na.klarna.com, OC api-oc.klarna.com — use the sandbox host while testing).
KLARNA_API_BASE=https://api.klarna.com

