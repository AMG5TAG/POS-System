# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/koapos
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Destructive-script guard (transfer-merchant) ─────────────────────────────
# Required by the transfer-merchant CLI to confirm which database it may modify.
# EXPECTED_DB must be set on the command line for any destructive run.
#   EXPECTED_DB=development | production
# Optional but recommended: lock each environment to a specific database by its
# fingerprint (a short sha256 of the connection host + db name). On first run the
# guard prints the live fingerprint so you can paste it here.
DB_FINGERPRINT_DEVELOPMENT=
DB_FINGERPRINT_PRODUCTION=

# ─── Token Vault ──────────────────────────────────────────────────────────────
# Optional: dedicated 32+ char string for AES-256-CBC token encryption.
# Falls back to SESSION_SECRET if not set.
VAULT_ENCRYPTION_KEY=change-me-to-a-32char-random-string

# ─── Cloud Storage ────────────────────────────────────────────────────────────
# Google (shared client for Drive, Business Profile, Contacts/Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (shared client for OneDrive, Contacts/Calendar)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ─── Business & Finance ───────────────────────────────────────────────────────
# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# QuickBooks Online (Intuit)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Stripe Connect (for merchants connecting their own Stripe account)
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=

# Zip Pay (buy-now-pay-later). Each merchant connects their OWN independent Zip
# account: the merchantId, apiKey AND webhook signing secret are entered per
# merchant in the app and encrypted in the token vault. The only platform-level
# setting is the API host (sandbox vs production), shared by all merchants.
#   ZIP_API_BASE — API host; use the Zip sandbox host while testing.
ZIP_API_BASE=https://api.zip.co

# ─── Social Media & Marketing ─────────────────────────────────────────────────
# Meta (Facebook & Instagram Business)
META_APP_ID=
META_APP_SECRET=

# Twitter / X
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# TikTok for Business
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
